@model List<CarRental.Models.Car>

@{
    ViewData["Title"] = "Booked Cars";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Booked Cars</h1>
    <a class="btn btn-secondary" asp-controller="Cars" asp-action="Index">Back to Cars</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No cars have been booked yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Car Name</th>
                    <th>Price Per Day</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td>@car.Id</td>
                        <td>@car.Name</td>
                        <td>PKR @car.PricePerDay.ToString("N0")</td>
                        <td><span class="badge bg-warning text-dark">Booked</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
